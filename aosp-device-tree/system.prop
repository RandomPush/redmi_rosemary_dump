# Audio
ro.audio.silent=0

# Bluetooth
ro.bluetooth.emb_wp_mode=false
ro.bluetooth.wipower=false

# Display
persist.vendor.dc_backlight.enable=false
ro.opengles.version=196610

# Health
ro.charger.enable_suspend=true

# Media
media.recorder.show_manufacturer_and_model=true

# Wi-Fi
ro.wifi.channels=
wifi.direct.interface=p2p0
wifi.interface=wlan0
wifi.tethering.interface=ap0

# Miscellaneous
Build.BRAND=MTK
dalvik.vm.appimageformat=lz4
dalvik.vm.dex2oat-Xms=64m
dalvik.vm.dex2oat-Xmx=512m
dalvik.vm.dex2oat-max-image-block-size=524288
dalvik.vm.dex2oat-minidebuginfo=true
dalvik.vm.dex2oat-resolve-startup-strings=true
dalvik.vm.dex2oat64.enabled=true
dalvik.vm.dexopt.secondary=true
dalvik.vm.dexopt.thermal-cutoff=2
dalvik.vm.enable_pr_dexopt=true
dalvik.vm.image-dex2oat-Xms=64m
dalvik.vm.image-dex2oat-Xmx=64m
dalvik.vm.lockprof.threshold=500
dalvik.vm.madvise.artfile.size=4294967295
dalvik.vm.madvise.odexfile.size=104857600
dalvik.vm.madvise.vdexfile.size=104857600
dalvik.vm.minidebuginfo=true
dalvik.vm.systemuicompilerfilter=speed
dalvik.vm.usap_pool_enabled=false
dalvik.vm.usap_pool_refill_delay_ms=3000
dalvik.vm.usap_pool_size_max=3
dalvik.vm.usap_pool_size_min=1
dalvik.vm.usap_refill_threshold=1
dalvik.vm.useartservice=true
dalvik.vm.usejit=true
debug.atrace.tags.enableflags=0
debug.cpurend.vsync=false
debug.hwui.target_cpu_time_percent=20
debug.hwui.use_hint_manager=true
mediatek.wlan.ctia=0
net.bt.name=Android
net.tethering.noprovisioning=true
persist.dbg.volte_avail_ovr=1
persist.dbg.vt_avail_ovr=1
persist.dbg.wfc_avail_ovr=1
persist.debug.dalvik.vm.core_platform_api_policy=just-warn
persist.sys.mdlog_dumpback=2
persist.sys.strictmode.disable=true
persist.traced.enable=1
persist.vendor.otg_control=true
pm.dexopt.ab-ota=speed-profile
pm.dexopt.bg-dexopt=speed-profile
pm.dexopt.boot-after-mainline-update=verify
pm.dexopt.boot-after-ota=verify
pm.dexopt.cmdline=verify
pm.dexopt.first-boot=verify
pm.dexopt.inactive=verify
pm.dexopt.install=speed-profile
pm.dexopt.install-bulk=speed-profile
pm.dexopt.install-bulk-downgraded=verify
pm.dexopt.install-bulk-secondary=verify
pm.dexopt.install-bulk-secondary-downgraded=verify
pm.dexopt.install-fast=skip
pm.dexopt.post-boot=verify
pm.dexopt.shared=speed
ro.actionable_compatible_property.enabled=true
ro.allow.mock.location=0
ro.camera.sound.forced=0
ro.com.google.clientidbase=android-xiaomi
ro.control_privapp_permissions=enforce
ro.dalvik.vm.native.bridge=0
ro.display.type=oled
ro.hardware.fp.sideCap=true
ro.iorapd.enable=false
ro.kernel.zio=38,108,105,16
ro.lineage.build.version=22.0
ro.lineage.device=rosemary
ro.lineage.display.version=22-20241127-UNOFFICIAL-rosemary
ro.lineage.releasetype=UNOFFICIAL
ro.lineage.version=22.0-20241127-UNOFFICIAL-rosemary
ro.lineagelegal.url=https://lineageos.org/legal
ro.llndk.api_level=202404
ro.mediatek.wlan.p2p=1
ro.mediatek.wlan.wsc=1
ro.modversion=22.0-20241127-UNOFFICIAL-rosemary
ro.mtk_perf_fast_start_win=1
ro.mtk_perf_response_time=1
ro.mtk_perf_simple_start_win=1
ro.ota.allow_downgrade=true
ro.postinstall.fstab.prefix=/system
ro.storage_manager.enabled=true
ro.sys.usb.bicr=no
ro.sys.usb.charging.only=yes
ro.sys.usb.mtp.whql.enable=0
ro.sys.usb.storage.type=mtp
ro.zram.first_wb_delay_mins=1440
ro.zram.mark_idle_delay_mins=60
ro.zram.periodic_wb_delay_hours=24
security.perf_harden=1
sys.ipo.disable=1
sys.ipo.pwrdncap=2
vendor.hbm.enable=true
vendor.rild.libargs=-d /dev/ttyC0
